[Unit]
Description=Trade Fair AI Matchmaker API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/brogrammers/backend
Environment=STORE_PATH=/var/lib/brogrammers/guests.json
ExecStart=/opt/brogrammers/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 4000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
